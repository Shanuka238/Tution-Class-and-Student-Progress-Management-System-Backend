# ==========================================
# Backend Environment Configuration
# ==========================================

NODE_ENV=development
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster01.mongodb.net/TCSP?retryWrites=true&w=majority

# Allowed Frontend Origins (Comma-separated for multiple domains)
# Local: http://localhost:5173
# Production: Set to your Vercel URL (e.g. https://your-project.vercel.app)
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_me
JWT_EXPIRE=30d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PayHere Payment Gateway
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_IS_SANDBOX=TRUE

# Google Gemini AI Chatbot
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
